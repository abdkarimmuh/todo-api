    "execute": [
      {
        "description": "create table \"todo\"",
        "sql": "CREATE TABLE \"public\".\"todo\" (\n  \"completed\" bool DEFAULT false NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"deadline\" timestamptz,\n  \"id\" uuid NOT NULL,\n  \"title\" text NOT NULL,\n  PRIMARY KEY (\"id\")\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"todo\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"todo\""
        ]
      }
    ]
  }
